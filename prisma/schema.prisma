// PhoneMail — Prisma schema
// Day 1: auth identity. Day 2: the email core. Day 4: thread state (reply-once + tags).

generator client {
  provider = "prisma-client-js"

  // Why this is pinned (found by container verification, Day 1 Phase C):
  // the build stages are node:22-bookworm-slim WITHOUT the `openssl` CLI, so
  // Prisma's runtime detection falls back to debian-openssl-1.1.x and generates
  // an engine the bookworm runtime cannot load:
  //   "Could not locate the Query Engine for runtime debian-openssl-3.0.x"
  // Declaring the target explicitly makes the generated client match the
  // runner image regardless of what detection guesses on the build machine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A PhoneMail account. The phone number IS the identity — there is no
/// password auth (see PROJECT.md §2: OTP-only, confirmed with evaluators).
model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  createdAt   DateTime @default(now())

  /// How the account was first created. The spec sends the "you have new mail"
  /// SMS only to people who registered somewhere OTHER than the mobile app, so
  /// this field is what makes that gate possible. Missing/unknown is treated as
  /// 'mobile' — the safe side is no SMS.
  registeredVia String @default("mobile")

  sentEmails     Email[] @relation("SentEmails")
  receivedEmails Email[] @relation("ReceivedEmails")

  /// Day 6 alias IDs: extra addresses that resolve to this same account.
  aliases        Alias[]
}

/// A delivered message. Rows are only ever created by the inbound delivery
/// path (/api/mail/inbound), never by the send endpoint, so a message that
/// never made it through SMTP cannot masquerade as delivered.
model Email {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  fromAddress String
  toAddress   String
  subject     String
  body        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  /// Reply-once (PROJECT.md §5: "reply-once"). Set on the message that was
  /// replied to, the moment a reply is submitted — the affordance disappears
  /// afterwards and the server refuses a second reply.
  repliedAt DateTime?

  /// Swipe-to-tag. Free-form but written from a small fixed set by the UI;
  /// Day 6's folders (Drafts/Spam/Trash) build on this field.
  tag String?

  /// Day 6 group chat. The DERIVED thread key of a multi-recipient message:
  /// "grp:" + sha256(sorted unique member numbers, comma-joined). NULL for
  /// pairwise mail, so 1:1 conversations group exactly as they did before, and
  /// a group thread is reconstructed from the rows alone - no thread table, no
  /// stored membership (see lib/threadKey.ts).
  threadKey String?

  /// Day 6 folders: which folder the RECIPIENT keeps this message in
  /// (inbox | spam | trash). Recipient-scoped state, like isRead and tag, so a
  /// move never affects what the sender sees. 'inbox' is the default, which is
  /// why no row ever needed a backfill.
  folder String @default("inbox")

  fromUser User @relation("SentEmails", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedEmails", fields: [toUserId], references: [id])

  /// Serves the inbox query: WHERE toUserId = ? ORDER BY createdAt DESC.
  @@index([toUserId, createdAt])
  /// Serves the thread query: WHERE (fromUserId = ? AND toUserId = ?) OR vice versa.
  @@index([fromUserId, toUserId, createdAt])
  /// Serves the group thread query: WHERE threadKey = ? ORDER BY createdAt.
  @@index([threadKey, createdAt])
  /// Serves a folder screen: WHERE toUserId = ? AND folder = ? ORDER BY createdAt.
  @@index([toUserId, folder, createdAt])
}

/// A second address for one account (Day 6). localPart is unique AND is checked
/// against User.phoneNumber at creation time, so "<localPart>@phonemail.com"
/// always resolves to exactly one user: an alias can neither shadow a phone
/// number nor be shadowed by one.
model Alias {
  id        String   @id @default(cuid())
  userId    String
  localPart String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves the settings list: WHERE userId = ? ORDER BY createdAt.
  @@index([userId, createdAt])
}
