// PhoneMail — Prisma schema
// Day 1: auth identity. Day 2: the email core. Day 4: thread state (reply-once + tags).

generator client {
  provider = "prisma-client-js"

  // Why this is pinned (found by container verification, Day 1 Phase C):
  // the build stages are node:22-bookworm-slim WITHOUT the `openssl` CLI, so
  // Prisma's runtime detection falls back to debian-openssl-1.1.x and generates
  // an engine the bookworm runtime cannot load:
  //   "Could not locate the Query Engine for runtime debian-openssl-3.0.x"
  // Declaring the target explicitly makes the generated client match the
  // runner image regardless of what detection guesses on the build machine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A PhoneMail account. The phone number IS the identity — there is no
/// password auth (see PROJECT.md §2: OTP-only, confirmed with evaluators).
model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  createdAt   DateTime @default(now())

  /// Day 9: one row per signed-in device. Deleting the account takes them all.
  sessions Session[]

  /// Day 7 display name. NULL means "show the number" - every reader falls back
  /// to the phone number through labelFor(), so nobody is ever nameless.
  displayName String?

  /// Day 7 profile picture, kept IN POSTGRES: the container filesystem is not
  /// durable, so a file on disk would not survive a rebuild. avatarMime is what
  /// the serving route returns as the content type and avatarUpdatedAt doubles
  /// as the cache key.
  avatarBytes     Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?

  /// Phase 0: bcrypt hash for the ADDED password-login path. NULL means "this
  /// account has no password yet" - the login screen then offers to set one
  /// through the OTP flow. OTP login stays primary.
  passwordHash String?

  /// ROUND 22: the app PIN, bcrypt-hashed. NULL means "no lock set". This gates
  /// the INTERFACE on a resumed session, not the API - the session token remains
  /// what authorises anything, which is why no other route reads this column.
  /// See docs/SECURITY.md, "The app PIN".
  pinHash String?

  /// How the account was first created. The spec sends the "you have new mail"
  /// SMS only to people who registered somewhere OTHER than the mobile app, so
  /// this field is what makes that gate possible. Missing/unknown is treated as
  /// 'mobile' — the safe side is no SMS.
  registeredVia String @default("mobile")

  /// The owner's switch for the "you have new mail" SMS. TRUE by default: the
  /// account opted into mail notifications when it was created, and only an
  /// explicit "no" from Settings turns them off. The delivery gate requires BOTH
  /// this and a non-mobile registration path, so the switch can only ever narrow
  /// who is notified - never widen it beyond what the spec allows.
  smsNotifications Boolean @default(true)

  sentEmails     Email[] @relation("SentEmails")
  receivedEmails Email[] @relation("ReceivedEmails")

  /// Day 6 alias IDs: extra addresses that resolve to this same account.
  aliases        Alias[]

  /// ROUND 22: the one active draft, if the account has an abandoned compose.
  draft Draft?

  /// The owner's address book. Names here OVERRIDE a raw number in the list and
  /// the thread headers, which is why the name lives on this row and not on User.
  contacts       Contact[]

  /// ROUND 30 (sender credibility): what this account has reported, and what
  /// has been reported against it. Removed explicitly in FK order by
  /// /api/me/delete, like every other relation of this table.
  spamReportsFiled   SpamReport[] @relation("SpamReportsFiled")
  spamReportsAgainst SpamReport[] @relation("SpamReportsAgainst")
}

model Contact {
  id          String   @id @default(cuid())
  userId      String
  address     String
  displayName String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per address per user; the list query is "mine, oldest first".
  @@unique([userId, address])
  @@index([userId, createdAt])
}

/// A delivered message. Rows are only ever created by the inbound delivery
/// path (/api/mail/inbound), never by the send endpoint, so a message that
/// never made it through SMTP cannot masquerade as delivered.
model Email {
  /// ROUND 9: which list this fan-out row's recipient came from - 'to' or 'cc' -
  /// stamped by the send path's submission note (see lib/submissions.ts). NULL for
  /// pairwise rows: a 1:1 message has no To/Cc distinction to record. The group
  /// member role tags are DERIVED from the founding mail's rows (lib/roles.ts).
  recipientRole String?

  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  fromAddress String
  toAddress   String
  subject     String
  body        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  /// Reply-once (PROJECT.md §5: "reply-once"). Set on the message that was
  /// replied to, the moment a reply is submitted — the affordance disappears
  /// afterwards and the server refuses a second reply.
  repliedAt DateTime?

  /// Swipe-to-tag. Free-form but written from a small fixed set by the UI;
  /// Day 6's folders (Drafts/Spam/Trash) build on this field.
  tag String?

  /// Day 9 (delete chat). PER-VIEWER deletion, and the reason it is two flags
  /// rather than a row delete: a message is ONE row that BOTH sides read, so
  /// removing the row would take the counterpart's copy with it. A flag takes the
  /// conversation out of ONE side's view - its list, its thread, its unread count -
  /// and leaves the other side's copy exactly where it was. That is what "delete
  /// this chat" can honestly mean for mail somebody else also holds.
  deletedForSender    Boolean @default(false)
  deletedForRecipient Boolean @default(false)

  /// ROUND 29 follow-up 6 (the owner: "mails are not listed [on the trash
  /// page] when i click move to trash"): the SENDER's own trash marker. A
  /// row's `folder` is the RECIPIENT's placement - a sent message cannot use
  /// it - so the sender's "Move to Trash" sets this flag (plus
  /// deletedForSender, which keeps the row out of the sender's views). The
  /// sender's trash screens list rows that carry it, Empty trash clears it,
  /// and "Move to inbox" restores the message. The recipient's copy is
  /// untouched, exactly like every other per-viewer flag.
  senderTrash Boolean @default(false)

  /// Day 6 group chat. The DERIVED thread key of a multi-recipient message:
  /// "grp:" + sha256(sorted unique member numbers, comma-joined). NULL for
  /// pairwise mail, so 1:1 conversations group exactly as they did before, and
  /// a group thread is reconstructed from the rows alone - no thread table, no
  /// stored membership (see lib/threadKey.ts).
  threadKey String?

  /// One value per SMTP SUBMISSION, shared by every fan-out row of it. A group
  /// broadcast to three members is three rows - one per recipient, each with its
  /// own read state, which is what makes per-member unread work - but it is ONE
  /// message. Without this the group view rendered the same text once per
  /// recipient, which is the "my own group messages render twice" bug.
  submissionId String?

  /// The row this message ANSWERS, when it is a reply. NULL for anything that is
  /// not a reply - which is also what makes a row a BROADCAST for the group
  /// visibility rule (see the group thread endpoint): broadcasts are read by
  /// every member, replies only by their sender and their recipient.
  replyToId String?

  /// Day 6 folders: which folder the RECIPIENT keeps this message in
  /// (inbox | spam | trash). Recipient-scoped state, like isRead and tag, so a
  /// move never affects what the sender sees. 'inbox' is the default, which is
  /// why no row ever needed a backfill.
  folder String @default("inbox")

  fromUser User @relation("SentEmails", fields: [fromUserId], references: [id])
  toUser   User @relation("ReceivedEmails", fields: [toUserId], references: [id])

  /// The files that travelled with this message (Day 8). One row per fan-out row,
  /// so the bytes are owned by the message they belong to - see the model below.
  attachments Attachment[]

  /// Serves the inbox query: WHERE toUserId = ? ORDER BY createdAt DESC.
  @@index([toUserId, createdAt])
  /// Serves the thread query: WHERE (fromUserId = ? AND toUserId = ?) OR vice versa.
  @@index([fromUserId, toUserId, createdAt])
  /// Serves the group thread query: WHERE threadKey = ? ORDER BY createdAt.
  @@index([threadKey, createdAt])
  /// Serves the collapse of one submission's fan-out rows.
  @@index([submissionId])
  /// Serves a folder screen: WHERE toUserId = ? AND folder = ? ORDER BY createdAt.
  @@index([toUserId, folder, createdAt])
}

/// ONE SIGNED-IN DEVICE.
///
/// The JWT has always been self-contained, which made it impossible to end: a token
/// stayed valid until it expired, and "log out" only forgot it locally. The token now
/// carries this row's id, so a session is valid only while this row exists - which is
/// what makes "log this device out", and "deleting the account logs every device out",
/// real WITHOUT a denylist of revoked tokens (a denylist grows for ever; a row does
/// not).
///
/// lastActiveAt is written THROTTLED (see lib/auth.ts): the row exists to be
/// recognised, not to be a request log.
model Session {
  id           String   @id @default(cuid())
  userId       String
  /// Whatever the client sent, so the list can say "Chrome on Windows" instead of
  /// showing a raw string. Null when the request carried none.
  userAgent    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The list is always "this user's sessions".
  @@index([userId])
}

/// A file attached to a delivered message. The BYTES LIVE IN POSTGRES, like the
/// avatar: the container filesystem is not durable, so a file on disk would not
/// survive a rebuild, and "no filesystem storage" was the requirement.
///
/// ONE ROW PER (Email row, file). A group broadcast fans out into one Email row per
/// recipient, so its attachments are stored once per row rather than shared through
/// a join table. That is a deliberate trade: it costs duplicated bytes for a group
/// message, and it buys the property that an attachment is owned by exactly the row
/// it belongs to - so the download check is the SAME party check the row already
/// has, with no second table to keep consistent, and deleting a message takes its
/// bytes with it through the cascade.
model Attachment {
  id          String   @id @default(cuid())
  emailId     String
  filename    String
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  /// Serves the per-message lookup: WHERE emailId = ? (and the delete cascade).
  @@index([emailId])
}

/// A second address for one account (Day 6). localPart is unique AND is checked
/// against User.phoneNumber at creation time, so "<localPart>@phonemail.com"
/// always resolves to exactly one user: an alias can neither shadow a phone
/// number nor be shadowed by one.
model Alias {
  id        String   @id @default(cuid())
  userId    String
  localPart String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves the settings list: WHERE userId = ? ORDER BY createdAt.
  @@index([userId, createdAt])
}

/// ROUND 22: ONE active draft per user - the message they were writing. A draft is
/// taken before anything is validated (an unfinished address is exactly what a draft
/// is for), so To and Cc are stored as the raw text the composer holds.
///
/// `userId` is UNIQUE, which is what makes "one active draft" a rule the database
/// enforces rather than a convention the route remembers.
model Draft {
  id     String @id @default(cuid())
  userId String @unique
  to     String @default("")
  cc     String @default("")
  subject String @default("")
  body    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ROUND 30 (sender credibility): one row per report - "this reporter says
/// this account sends spam". The UNIQUE pair IS the idempotency rule: a
/// second attempt is a no-op, never a double count, so an account's
/// report count is DISTINCT reporters by construction. A report is a
/// SIGNAL: it blocks nothing and deletes nothing by itself, and no reader
/// ever sees who filed one.
model SpamReport {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  createdAt      DateTime @default(now())

  /// No onDelete rules, matching Email's relations: /api/me/delete removes
  /// the rows explicitly, in FK order, and reports the count - the schema
  /// would rather refuse a stray delete than take rows silently with it.
  reporter     User @relation("SpamReportsFiled", fields: [reporterId], references: [id])
  reportedUser User @relation("SpamReportsAgainst", fields: [reportedUserId], references: [id])

  /// One report per reporter per reported account.
  @@unique([reporterId, reportedUserId])
  /// Serves the reported account's count: WHERE reportedUserId = ?.
  @@index([reportedUserId])
}
