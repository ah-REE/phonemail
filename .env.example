# Copy to .env for local, non-Docker development only.
# Docker Compose supplies its own values (see docker-compose.yml), so the
# evaluator never needs this file.

# Postgres (local) — when running `npm run dev` with a manually started DB
DATABASE_URL="postgresql://phonemail:phonemail@localhost:5432/phonemail?schema=public"

# Redis (local)
REDIS_URL="redis://localhost:6379"

# Secret used to sign JWTs — MUST be replaced with a long random value
JWT_SECRET="change-me-local-dev-secret"

# Fast2SMS OTP route API key (Day 2 wires the real send; Day 1 uses a fake OTP)
FAST2SMS_API_KEY="replace-with-real-fast2sms-api-key"
