# =============================================================================
# PhoneMail environment reference - the SINGLE catalog of every variable.
#
# The app reads its environment from docker-compose.yml. NO .env file is
# required, loaded, or expected - a fresh clone needs nothing beyond:
#
#     git clone <repo-url> && cd phonemail && docker compose up -d
#
# This file is a reference catalog, not something the evaluator copies anywhere.
# Values below are the committed ones; "placeholder" values are what keeps the
# no-secrets boot working. Read it together with the README's "Environment &
# configuration" section: it explains every entry below in one table, plus the
# three setup paths (run as-is / change one value / enable real SMS).
# =============================================================================

# -----------------------------------------------------------------------------
# SECTION 1 - SET BY DOCKER COMPOSE (required; committed values, placeholders
# where a real secret would go). All of these are wired into docker-compose.yml
# and take effect with no edits.
# -----------------------------------------------------------------------------

# DATABASE_URL
#   where:       app container
#   what:        Postgres connection string (internal Compose DNS name)
#   required:    yes
#   value:       postgresql://phonemail:phonemail@postgres:5432/phonemail?schema=public
DATABASE_URL="postgresql://phonemail:phonemail@postgres:5432/phonemail?schema=public"

# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   where:       postgres container
#   what:        the database's own initialisation
#   required:    yes
#   values:      phonemail / phonemail / phonemail
POSTGRES_USER="phonemail"
POSTGRES_PASSWORD="phonemail"
POSTGRES_DB="phonemail"

# REDIS_URL
#   where:       app container
#   what:        Redis connection string (OTPs, cooldowns, throttles)
#   required:    yes
#   value:       redis://redis:6379
REDIS_URL="redis://redis:6379"

# JWT_SECRET
#   where:       app container
#   what:        signs session tokens; MUST be replaced with a long random value
#                before any real deployment (see Section 2)
#   required:    yes
#   value:       change-me-placeholder-jwt-secret
JWT_SECRET="change-me-placeholder-jwt-secret"

# MAIL_WEBHOOK_SECRET
#   where:       app AND smtp containers (must be equal; rotate together)
#   what:        authenticates the smtp -> app inbound webhook
#   required:    yes
#   value:       replace-with-real-mail-webhook-secret
MAIL_WEBHOOK_SECRET="replace-with-real-mail-webhook-secret"

# IVR_WEBHOOK_SECRET
#   where:       app container
#   what:        shared secret for the Twilio IVR signup webhook
#                (<public-url>/api/ivr/signup?token=<this value>); the legacy
#                Exotel one-shot path uses the same token
#   required:    yes
#   value:       replace-with-real-ivr-webhook-secret
IVR_WEBHOOK_SECRET="replace-with-real-ivr-webhook-secret"

# MAIL_DOMAIN
#   where:       app AND smtp containers
#   what:        the mail domain both sides accept
#   required:    yes
#   value:       phonemail.com
MAIL_DOMAIN="phonemail.com"

# SMTP_HOST / SMTP_PORT
#   where:       app container (host) / app AND smtp (port)
#   what:        the internal mail hop
#   required:    yes
#   values:      smtp / 25
SMTP_HOST="smtp"
SMTP_PORT="25"

# APP_INBOUND_URL
#   where:       smtp container
#   what:        where the smtp service posts each parsed message
#   required:    yes
#   value:       http://app:3000/api/mail/inbound
APP_INBOUND_URL="http://app:3000/api/mail/inbound"

# SMS_GATE_LOGIN / SMS_GATE_PASSWORD
#   where:       app container
#   what:        sms-gate.app credentials - your ACCOUNT in the sms-gate.app
#                Android app that will send the texts (that account's login and
#                password ARE these two values; see the README's "Where the
#                sms-gate.app credentials come from"). While either is still the
#                committed PLACEHOLDER below, no SMS is attempted and the API
#                answers with the fixed dev OTP 123456 plus a devHint - which is
#                exactly what keeps the evaluator's boot working.
#   required:    yes (placeholders are the working default)
#   values:      replace-with-real-sms-gate-login / replace-with-real-sms-gate-password
SMS_GATE_LOGIN="replace-with-real-sms-gate-login"
SMS_GATE_PASSWORD="replace-with-real-sms-gate-password"

# NODE_ENV / PORT
#   where:       app container
#   what:        runtime mode and the app's listening port (published as 3000:3000)
#   required:    yes
#   values:      production / 3000
NODE_ENV="production"
PORT="3000"

# HOSTNAME
#   where:       app container
#   what:        the bind address server.mjs uses; Docker injects this per
#                container automatically, and the code falls back to 0.0.0.0
#   required:    no (Docker supplies it)

# -----------------------------------------------------------------------------
# SECTION 2 - REAL-VALUE OVERRIDES (optional; gitignored override file).
# Copy docker-compose.override.yml.example to docker-compose.override.yml and
# fill in real values; Compose merges it automatically, no extra flags.
#
#   SMS_GATE_LOGIN / SMS_GATE_PASSWORD   real sms-gate.app credentials. Setting
#       both switches the app OUT of dev-OTP mode: codes become real 6-digit
#       values sent through the gateway phone. Do not enable while testing.
#   JWT_SECRET                           rotate the committed placeholder here.
#   MAIL_WEBHOOK_SECRET / IVR_WEBHOOK_SECRET   rotate the placeholders here.
#
# Rotation policy: the committed values are placeholders, safe to publish;
# every real secret lives ONLY in the gitignored override, which is never
# committed (git check-ignore -v docker-compose.override.yml proves the rule).
# Rotating any secret means editing the override and restarting the stack.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# SECTION 3 - NOT READ BY THIS BUILD (reference only; transport history).
# The OTP transport history: Fast2SMS (blocked by KYC) -> Twilio trial
# (verification walls for Indian numbers) -> the self-hosted sms-gate.app
# gateway that ships today. These variables belong to the superseded transports
# and no code path reads them; they are listed so no key is silently forgotten.
# -----------------------------------------------------------------------------
# FAST2SMS_API_KEY       the Day-1 transport's route API key
# TWILIO_ACCOUNT_SID     the Twilio-trial transport (all three, together)
# TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER
