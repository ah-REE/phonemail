# Copy to .env for local, non-Docker development only.
# Docker Compose supplies its own values (see docker-compose.yml), so the
# evaluator never needs this file. Real secrets belong in
# docker-compose.override.yml, which is gitignored — see
# docker-compose.override.yml.example.

# Postgres (local) — when running `npm run dev` with a manually started DB
DATABASE_URL="postgresql://phonemail:phonemail@localhost:5432/phonemail?schema=public"

# Redis (local)
REDIS_URL="redis://localhost:6379"

# Secret used to sign JWTs — MUST be replaced with a long random value
JWT_SECRET="change-me-placeholder-jwt-secret"

# --- SMS transport (sms-gate.app: self-hosted Android gateway) ---
# Both must be real to enable real SMS. While either is still the placeholder
# below, the API skips SMS and uses the fixed dev OTP 123456 (that is what keeps
# the evaluator's boot working). Real sends need the gateway phone online.
SMS_GATE_LOGIN="replace-with-real-sms-gate-login"
SMS_GATE_PASSWORD="replace-with-real-sms-gate-password"

# --- mail path ---
SMTP_HOST="localhost"
SMTP_PORT="25"
MAIL_DOMAIN="phonemail.com"
MAIL_WEBHOOK_SECRET="replace-with-real-mail-webhook-secret"
