# Copy to .env for local, non-Docker development only.
# Docker Compose supplies its own values (see docker-compose.yml), so the
# evaluator never needs this file. Real secrets belong in
# docker-compose.override.yml, which is gitignored — see
# docker-compose.override.yml.example.

# Postgres (local) — when running `npm run dev` with a manually started DB
DATABASE_URL="postgresql://phonemail:***@localhost:5432/phonemail?schema=public"

# Redis (local)
REDIS_URL="redis://localhost:6379"

# Secret used to sign JWTs — MUST be replaced with a long random value
JWT_SECRET="change-me-placeholder-jwt-secret"

# --- SMS transport (Twilio) ---
# All three must be real to enable real SMS. While any of them is still the
# placeholder value below, the API skips SMS and uses the fixed dev OTP 123456
# (that is what keeps the evaluator's boot working).
# Replaced Fast2SMS, which requires KYC before any send.
TWILIO_ACCOUNT_SID="replace-with-real-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-real-twilio-auth-token"
TWILIO_FROM_NUMBER="replace-with-real-twilio-from-number"

# --- mail path ---
SMTP_HOST="localhost"
SMTP_PORT="25"
MAIL_DOMAIN="phonemail.com"
MAIL_WEBHOOK_SECRET="replace-with-real-mail-webhook-secret"
