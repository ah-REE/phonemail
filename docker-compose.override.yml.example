# Copy this file to docker-compose.override.yml and fill in the real values.
#
# docker-compose.override.yml is gitignored (verify with `git check-ignore -v
# docker-compose.override.yml`); this .example file is the committed reference.
# Compose merges the override over docker-compose.yml automatically, so
# `docker compose up -d` needs no extra flags.
#
# sms-gate.app is a self-hosted Android SMS gateway: the phone running the app
# (logged into your account) carries the SIM that sends the messages, so the
# gateway phone must be online for a real send to arrive.

services:
  app:
    environment:
      # Credentials you created in the sms-gate.app web console.
      SMS_GATE_LOGIN: "your-sms-gate-login"
      SMS_GATE_PASSWORD: "your-sms-gate-password"
