# Copy this file to docker-compose.override.yml and fill in the real values.
#
# docker-compose.override.yml is gitignored (verify with `git check-ignore -v
# docker-compose.override.yml`); this .example file is the committed reference.
# Compose merges the override over docker-compose.yml automatically, so
# `docker compose up -d` needs no extra flags.
#
# BASIC BY DESIGN: this template carries only the two things a real deployment
# fills in - the sms-gate.app credentials (which switch real SMS on) and the
# IVR webhook's secret. Every value below mirrors the committed placeholder, so
# an unfilled copy changes nothing and the stack keeps running in dev mode.
#
# Anything else (JWT_SECRET, the mail secret, a domain or a port) can join this
# file the same way - name the key under the service that reads it. Every
# variable is explained in the README's "Environment & configuration".
#
# sms-gate.app is the Android SMS gateway: the phone running the app (logged
# into your account) carries the SIM that sends the messages, so the gateway
# phone must be online for a real send to arrive.

services:
  app:
    environment:
      # --- 1. The switch to real SMS mode - the two values to fill -----------
      # Your sms-gate.app credentials: install the Android app -> START the
      # Cloud Server -> LOG IN. The username and password it gives you ARE
      # these two. While both are still the placeholders, the app stays in
      # dev mode: fixed OTP 123456 + devHint, and no SMS is attempted.
      SMS_GATE_LOGIN: "replace-with-real-sms-gate-login"
      SMS_GATE_PASSWORD: "replace-with-real-sms-gate-password"

      # --- 2. IVR signup webhook (Twilio) ------------------------------------
      # The shared token for the voice signup line. The integration is INBOUND
      # - Twilio calls this app - so no Twilio credentials live here; this
      # token is the only secret, and it is checked on every request.
      # Point the Twilio voice number at
      # <public-url>/api/ivr/signup?token=<this value> - the README's
      # "Setting up the Twilio IVR" guide walks through it.
      IVR_WEBHOOK_SECRET: "replace-with-real-ivr-webhook-secret"

