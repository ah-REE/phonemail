# Copy this file to docker-compose.override.yml and fill in the real values.
#
# docker-compose.override.yml is gitignored (verify with `git check-ignore -v
# docker-compose.override.yml`); this .example file is the committed reference.
# Compose merges the override over docker-compose.yml automatically, so
# `docker compose up -d` needs no extra flags.
#
# HOW TO READ THIS FILE
#   - Blocks 1-3 configure the `app` service; block 4 configures `smtp`.
#   - MINIMUM for real SMS: fill the two gateway values in block 1. Everything
#     else is for rotating secrets; left at the placeholders below, each line
#     keeps the committed default from docker-compose.yml - an unfilled copy
#     changes nothing, and an unedited stack stays in dev mode.
#   - Some values are read by BOTH services (`MAIL_WEBHOOK_SECRET` below; also
#     `MAIL_DOMAIN` and `SMTP_PORT` if you ever change them). A drifted pair
#     breaks mail SILENTLY: smtp accepts the message, its callback to the app
#     is refused (401), and the message never reaches any inbox. To make that
#     impossible, the shared secret is written exactly ONCE, as the YAML
#     anchor just below, and both services reference it.
#   - Any other key from the catalog in `.env.example` can be overridden the
#     same way - name it under the service that reads it.
#
# sms-gate.app is the Android SMS gateway: the phone running the app (logged
# into your account) carries the SIM that sends the messages, so the gateway
# phone must be online for a real send to arrive.

# THE ONE MAIL SECRET - edit this single line; both services below use it.
x-mail-secret: &mail_secret "replace-with-real-mail-webhook-secret"

services:
  app:
    environment:
      # --- 1. The switch to real SMS mode - the two values to fill -----------
      # Your sms-gate.app credentials: install the Android app -> START the
      # Cloud Server -> LOG IN. The username and password it gives you ARE
      # these two. While both are still the placeholders, the app stays in
      # dev mode: fixed OTP 123456 + devHint, and no SMS is attempted.
      SMS_GATE_LOGIN: "replace-with-real-sms-gate-login"
      SMS_GATE_PASSWORD: "replace-with-real-sms-gate-password"

      # --- 2. Rotate before any real deployment ------------------------------
      # Signs every session token - a long random value. Rotating it signs
      # everyone out; that is the point.
      JWT_SECRET: "change-me-placeholder-jwt-secret"
      # Authenticates the smtp -> app inbound webhook. Read by BOTH services -
      # defined once as *mail_secret (the anchor above).
      MAIL_WEBHOOK_SECRET: *mail_secret

      # --- 3. IVR signup webhook (Twilio) ------------------------------------
      # Point the Twilio voice number at
      # <public-url>/api/ivr/signup?token=<this value> - the README's
      # "Setting up the Twilio IVR" guide walks through it.
      IVR_WEBHOOK_SECRET: "replace-with-real-ivr-webhook-secret"

  smtp:
    environment:
      # --- 4. The mail hop's other half (same secret, same single source) ----
      # Besides this secret the smtp service also reads MAIL_DOMAIN, SMTP_PORT
      # and APP_INBOUND_URL - all keep the committed defaults unless you
      # override them the same way.
      MAIL_WEBHOOK_SECRET: *mail_secret
